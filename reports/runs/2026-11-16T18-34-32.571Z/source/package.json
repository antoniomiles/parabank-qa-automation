    "requirements:extract": "node scripts/extract-requirements.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.3",
    "pdfjs-dist": "^6.5.438",
